{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["server.ts", "api/**/*.ts", "models/**/*.ts", "middleware/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
